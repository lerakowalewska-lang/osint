RewriteEngine On
DirectorySlash Off

# www → non-www (заодно на https)
RewriteCond %{HTTP_HOST} ^www\.huntedlead\.ru$ [NC]
RewriteRule ^ https://huntedlead.ru%{REQUEST_URI} [R=301,L]

# http → https
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Route /api/send-lead to PHP handler
RewriteRule ^api/send-lead$ /api/send-lead.php [L]

# ВРЕМЕННО: прямой доступ к установщику WordPress (пока не готов финальный маппинг /blog).
# DirectorySlash Off выше не даёт Apache самому дописать слэш и отдать wp-blog/index.php,
# поэтому маршрутизируем явно, в обход directory-index и правила "strip trailing slash".
RewriteRule ^wp-blog/?$ /wp-blog/index.php [L]

# Serve .html files without extension
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Redirect trailing slash to no-slash
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)/$ /$1 [R=301,L]

# 404 page
ErrorDocument 404 /404.html
